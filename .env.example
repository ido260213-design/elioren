# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Phase 1+) ---
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — never expose to the client / never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (Phase 2+: AI match score, assistant panel) ---
# Server-only — calls to Claude happen from route handlers/edge functions, never the client.
ANTHROPIC_API_KEY=sk-ant-your-key

# --- Stripe (Phase 3: escrow-style payments + HireUp Premium) ---
# Test-mode keys only until a human explicitly decides to go live.
STRIPE_SECRET_KEY=sk_test_your-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key
# Leave unset. Setting this to "true" is the one, explicit, separate decision required
# before src/lib/stripe.ts will let a non sk_test_/rk_test_ key make live API calls —
# see "Going live with Stripe" in the README before ever setting it.
ALLOW_STRIPE_LIVE_MODE=false

# --- Mapbox (Phase 2: nearby jobs map) ---
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# --- Email (optional, not in the original build spec's env var list) ---
# Without this, guardian-confirmation and guardian-payout-setup emails (Phase 1/3) log
# to the server console instead of sending — see src/lib/email.ts.
RESEND_API_KEY=re_your-key
EMAIL_FROM=HireUp <noreply@your-domain.com>

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
